# ── PostgreSQL (DB/scripts 수집 스크립트와 docker-compose db 서비스가 함께 사용) ──
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 수집 스크립트(DB/scripts/*.py)가 접속할 주소
DB_HOST=
DB_PORT=

# ── docker-compose 전용 ──
# Backend/LLM 컨테이너가 접속할 DB. 미설정 시 compose가 띄우는 db 컨테이너를 사용
# ⚠️ 팀 공용 DB를 지정하면 Backend 기동 시 P0-3 TRUNCATE가 그 DB를 비운다
#    (Docs/STATUS.md P0-3 참고). 해결 전까지는 비워 둘 것
COMPOSE_DB_HOST=
COMPOSE_DB_PORT=

# ── Backend ──
# 토큰 서명 키. 미설정 시 코드의 개발용 기본값 사용
TOKEN_SECRET=
# LLM 호출 제한시간(초). 미설정 시 25
LLM_TIMEOUT_SECONDS=

# ── LLM ──
LLM_MODEL=
EMBEDDING_MODEL=
OPENAI_API_KEY=
COHERE_API_KEY=
VECTOR_STORE_BACKEND=postgres

# ── 외부 데이터 수집 API ──
ONTONG_YOUTH_API_KEY=
LAW_API_KEY=
GOV24_API_KEY=
